# =========================================================================
# MoSPI Real-Time Airfare Price Index (APIx) - Configuration
# =========================================================================

# (Optional) Google Gemini API Key for autonomous natural language situation room
# If left empty, the platform automatically runs in 100% offline audited deterministic econometric mode.
GEMINI_API_KEY=

# Target LLM Model (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Server Port (Default: 8000)
PORT=8000

# Enable Playwright Headless Scraping on Cloud Containers (Default: 1)
ENABLE_CLOUD_PLAYWRIGHT=1
